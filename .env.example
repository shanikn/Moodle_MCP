# Copy this file to .env and fill in your own values.
# Never commit .env or share these values with anyone.
# On Google Cloud Run, set the same names as environment variables instead.

# --- Moodle (required) ---
MOODLE_BASE_URL=https://moodle.runi.ac.il

# Each academic year is its own Moodle site (https://moodle.runi.ac.il/<year>) and needs
# its own token. Add one MOODLE_TOKEN_<year> line per year you want to read.
#
# Getting a token (the "Security keys" page doesn't show it, because login is via SSO):
#   1. Log in to https://moodle.runi.ac.il/<year> in your browser.
#   2. Open DevTools (F12) -> Network tab, tick "Preserve log".
#   3. In the same tab, open:
#      https://moodle.runi.ac.il/<year>/admin/tool/mobile/launch.php?service=moodle_mobile_app&passport=12345&urlscheme=moodlemobile
#   4. The page redirects to moodlemobile://token=<base64>. Copy the <base64> part from the
#      Network log and base64-decode it. The result is <signature>:::<token>.
#      Use only the part after ":::".
MOODLE_TOKEN_2027=your_moodle_token_here

# The year tools use when no year is given. Must have a MOODLE_TOKEN_<year> line above.
MOODLE_DEFAULT_YEAR=2027

# --- Yedion via My RUNI (optional) ---
# Only needed for exam_schedule, class_schedule, search_exam_bank, exam_notebooks,
# read_exam_notebook_file and read_exam_bank_file. The same username and password you
# use to log in to My RUNI / Moodle. Leave empty to use only the Moodle tools.
RUNI_USERNAME=
RUNI_PASSWORD=

# --- Hosting (only when deploying, e.g. Google Cloud Run) ---
# Leave these unset to run locally over stdio (Claude Desktop / Claude Code).
# MCP_TRANSPORT=http
#
# A random string of at least 32 characters that you generate yourself:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Your connector URL is then https://<your-host>/<MCP_SECRET_PATH>/mcp
# Treat it like a password: anyone with the URL can read your Moodle and Yedion.
# MCP_SECRET_PATH=
#
# PORT is set automatically by Cloud Run; don't set it yourself.
